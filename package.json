{
  "name": "quickkee",
  "version": "0.1.0",
  "description": "KeePass-compatible password manager browser extension (Chrome MV3) for local and cloud .kdbx databases.",
  "license": "MIT",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:firefox": "nodemon --config nodemon.firefox.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:chrome:test": "vite build --config vite.config.chrome.ts --mode test",
    "test:e2e": "yarn build:chrome:test && playwright test"
  },
  "type": "module",
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.11",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "fs-extra": "^11.3.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.10",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.9"
  }
}
