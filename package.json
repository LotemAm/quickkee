{
  "name": "quickkee",
  "version": "0.5.0",
  "description": "KeePass-compatible password manager browser extension (Chrome MV3) for local and cloud .kdbx databases.",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:production": "vite build --config vite.config.chrome.ts --mode production",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:firefox": "nodemon --config nodemon.firefox.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "build:chrome:test": "vite build --config vite.config.chrome.ts --mode test",
    "test:e2e": "yarn build:chrome:test && playwright test"
  },
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "patch:kdbxweb@npm%3A2.1.1#~/.yarn/patches/kdbxweb-npm-2.1.1-135bdb8acb.patch",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.16"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.1",
    "nodemon": "^3.1.14",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "@xmldom/xmldom": "0.9.12"
  }
}
