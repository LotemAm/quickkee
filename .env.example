# Public OAuth client IDs; these are identifiers, not secrets.
VITE_DROPBOX_CLIENT_ID=your-dropbox-app-key

# Create this as a Google OAuth "Web application" client. Its authorized
# redirect URI must be exactly:
# https://lotemam.github.io/quickkee/oauth/callback/
VITE_GDRIVE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
